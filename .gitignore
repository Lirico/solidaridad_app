# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS
.DS_Store
*.class
*.log
*.pyc
*.swp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Mobile (Flutter/Dart)
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/coverage/
mobile/**/doc/api/
mobile/**/ios/Flutter/.last_build_id
mobile/app.*.symbols
mobile/app.*.map.json
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release

# POC Verifone (Flutter) — also covered by poc_verifone/.gitignore
poc_verifone/.dart_tool/
poc_verifone/.flutter-plugins-dependencies
poc_verifone/.pub-cache/
poc_verifone/.pub/
poc_verifone/build/
poc_verifone/coverage/
poc_verifone/**/doc/api/
poc_verifone/**/ios/Flutter/.last_build_id
poc_verifone/app.*.symbols
poc_verifone/app.*.map.json
poc_verifone/android/app/debug
poc_verifone/android/app/profile
poc_verifone/android/app/release

# Shared packages
packages/**/.venv/
packages/**/__pycache__/
packages/**/*.pyc
packages/**/.coverage
packages/**/.mypy_cache/
packages/**/.pytest_cache/
packages/**/.ruff_cache/
packages/**/dist/
packages/**/*.egg-info/

# API
api/.env
api/.env.*
!api/.env.example
api/.venv/
api/__pycache__/
api/**/__pycache__/
api/*.pyc
api/.coverage
api/htmlcov/
api/coverage.xml
api/node_modules/
api/dist/

# Payment gateway
payment-gateway/.env
payment-gateway/.env.*
!payment-gateway/.env.example
payment-gateway/.venv/
payment-gateway/__pycache__/
payment-gateway/**/__pycache__/
payment-gateway/*.pyc
payment-gateway/.coverage
payment-gateway/htmlcov/
payment-gateway/coverage.xml
payment-gateway/.mypy_cache/
payment-gateway/.pytest_cache/
payment-gateway/.ruff_cache/
