APP_ENV=local
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

POSTGRES_USER=solidaridad
POSTGRES_PASSWORD=solidaridad
POSTGRES_DB=solidaridad
POSTGRES_PORT=5434

DATABASE_URL=postgresql+psycopg://solidaridad:solidaridad@localhost:5434/solidaridad

JWT_SECRET=change-me-local-dev-only-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=90

PAYMENT_GATEWAY_URL=http://127.0.0.1:8001
PAYMENT_GATEWAY_TIMEOUT_SECONDS=35

# Enabled by default; set false only for maintenance or deterministic tests.
EMBEDDED_RECOVERY_WORKER_ENABLED=true
EMBEDDED_RECOVERY_WORKER_SHUTDOWN_GRACE_SECONDS=40
# Degrade readiness if the loop makes no progress for this many seconds.
RECOVERY_WORKER_MAX_ITERATION_AGE_SECONDS=30
