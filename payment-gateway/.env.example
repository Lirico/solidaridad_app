APP_ENV=local

# mock = no processor needed; tcp = talk to authkig
ISO_TRANSPORT=mock

# Used when ISO_TRANSPORT=tcp (payment_processor local defaults)
ISO_HOST=127.0.0.1
ISO_PORT=4452
ISO_CONNECT_TIMEOUT_SECONDS=5
ISO_READ_TIMEOUT_SECONDS=30

# Dialecto KIG (valores locales de ejemplo; ajustar al entorno)
ISO_TPDU=6000030000
ISO_NII=003
ISO_PROCESSING_CODE=000000
ISO_POS_ENTRY_MODE=012
ISO_POS_CONDITION_CODE=00
